# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
# IMPORTANT: Change this to a strong random secret in production!
# You can generate one with: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-key-here-change-this-in-production-minimum-32-characters-required

# JWT Token Expiration (in milliseconds)
# Default: 86400000 = 24 hours
JWT_EXPIRATION_MS=86400000
